<Window x:Class="WpfApp.PinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enter PIN" Height="200" Width="300">
    <Grid Background="#FF492567">
        <StackPanel Margin="10">
            <TextBlock Text="Enter PIN:" FontSize="16" Margin="10"/>
            <PasswordBox x:Name="PinBox" FontSize="16" Margin="10" Width="200" HorizontalAlignment="Center"/>
            <Button Content="Submit" Click="Submit_Click" FontSize="16" Margin="10" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
