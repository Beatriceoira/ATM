<Window x:Class="WpfApp.DepositWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Deposit" Height="400" Width="400" Background="#FF492567">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="296*"/>
            <ColumnDefinition Width="105*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Select Amount to Deposit:" FontSize="16" Margin="10,10,10,10" Grid.ColumnSpan="2"/>
        <StackPanel Grid.Row="1" Margin="10,10,10,10" Orientation="Vertical" Grid.ColumnSpan="2">
            <Button Content="500" Click="FixedAmountButton_Click" Tag="500" FontSize="16" Margin="5"/>
            <Button Content="1000" Click="FixedAmountButton_Click" Tag="1000" FontSize="16" Margin="5"/>
            <Button Content="2000" Click="FixedAmountButton_Click" Tag="2000" FontSize="16" Margin="5"/>
            <Button Content="3000" Click="FixedAmountButton_Click" Tag="3000" FontSize="16" Margin="5"/>
            <Button Content="5000" Click="FixedAmountButton_Click" Tag="5000" FontSize="16" Margin="5"/>
            <Button Content="10000" Click="FixedAmountButton_Click" Tag="10000" FontSize="16" Margin="5"/>
            <TextBox x:Name="CustomDepositAmountTextBox" FontSize="16" Margin="10" Text="Enter custom amount"/>
            <Button Content="Deposit Custom Amount" Click="DepositCustomAmountButton_Click" FontSize="16"/>
            <Button Content="Back to Main Page" Click="BackToMain_Click" FontSize="16"/>

            <!-- Back Button -->
        </StackPanel>
    </Grid>
</Window>
